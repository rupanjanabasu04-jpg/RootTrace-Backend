# Application
APP_NAME=RootTrace API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL connection URL. Set this to your local database URL after copying
# this file to .env. Do not commit the resulting .env file.
# Format: postgresql+psycopg://<username>:<password>@localhost:5432/<database>
DATABASE_URL=

# Comma-separated frontend origins allowed to call the API
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional AI explanation layer. Keep the API key secret and never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
